# Copy this file to keystore.properties in the project root and fill in your own values.
#
# keystore.properties is git-ignored. Never commit it, and never commit the .jks file itself.
# If you lose the keystore you cannot update an already installed app: back it up somewhere safe.
#
# storeFile may be an absolute path, or a path relative to the project root.

storeFile=C:/Users/you/keys/sweep-release.jks
storePassword=
keyAlias=sweep
keyPassword=

# The same four values can be supplied as environment variables instead, which is what a CI
# machine would use:
#
#   SWEEP_STORE_FILE, SWEEP_STORE_PASSWORD, SWEEP_KEY_ALIAS, SWEEP_KEY_PASSWORD
