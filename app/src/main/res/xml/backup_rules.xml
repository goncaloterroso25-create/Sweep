<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android-12 equivalent of data_extraction_rules.xml. Backup is off entirely, but stating
  the intent explicitly keeps the two paths consistent.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
</full-backup-content>
