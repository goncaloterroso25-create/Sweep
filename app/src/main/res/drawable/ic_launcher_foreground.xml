<?xml version="1.0" encoding="utf-8"?>
<!--
  The Sweep mark.

  Three bars shortening as they descend, with one detached fragment left behind on the last
  row: matter being cleared away to the right, with the leftovers going last. It is the same
  idea as the block field inside the app, reduced to four strokes, and it deliberately avoids
  the broom-and-sparkle look every other cleaner uses.

  Drawn with round-capped strokes rather than rounded-rectangle paths so the geometry stays
  readable and editable.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <group
        android:pivotX="54"
        android:pivotY="54"
        android:rotation="-14">

        <path
            android:pathData="M34.5,44.5 L71.5,44.5"
            android:strokeColor="@color/sweep_accent"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
        <path
            android:pathData="M46.5,57.5 L71.5,57.5"
            android:strokeColor="@color/sweep_accent"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
        <path
            android:pathData="M58.5,70.5 L71.5,70.5"
            android:strokeColor="@color/sweep_accent"
            android:strokeWidth="9"
            android:strokeLineCap="round" />

        <!-- The fragment that has not been swept yet. -->
        <path
            android:pathData="M34.2,70.5 L35.0,70.5"
            android:strokeColor="@color/sweep_accent"
            android:strokeAlpha="0.45"
            android:strokeWidth="9"
            android:strokeLineCap="round" />
    </group>
</vector>

