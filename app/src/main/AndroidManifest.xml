<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      Sweep needs broad file access to do its job at all: duplicate detection and stale-download
      analysis are meaningless over a handful of MediaStore collections. The permissions below are
      deliberately grouped and annotated, because several of them are Play Store restricted.
      See docs/ANDROID_CONSTRAINTS.md before attempting a store release.
    -->

    <!-- Android 11+ : "All files access". Play Store restricted (file manager / antivirus only). -->
    <uses-permission
        android:name="android.permission.MANAGE_EXTERNAL_STORAGE"
        tools:ignore="ScopedStorage" />

    <!-- Android 8-10 : the legacy runtime pair. Not requested on newer releases. -->
    <uses-permission
        android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <!-- Usage Access. Not a runtime permission: it is granted from a Settings screen. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Android 11+ package visibility. Play Store restricted. -->
    <uses-permission
        android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!--
      Required since Android 8 to launch ACTION_UNINSTALL_PACKAGE. Without it the system may
      quietly drop the request, which is why uninstall appeared to do nothing on one test device.
      It does not let Sweep remove anything by itself: Android still shows its own confirmation
      and performs the removal.
    -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />

    <!--
      Optional reminders, off by default. Android 13+ treats this as a runtime permission, and
      Sweep only asks for it at the moment the user switches a reminder on, never at launch.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      WorkManager contributes four permissions of its own to the merged manifest. Two are removed
      here because Sweep's reminder job cannot use them: it declares no network constraint, so
      ACCESS_NETWORK_STATE is dead weight, and it never runs expedited work, so it never starts a
      foreground service. An app that tells people it has no networking should not ship a network
      permission it does not use.

      WAKE_LOCK and RECEIVE_BOOT_COMPLETED are kept: the first is how WorkManager finishes a job it
      has started, and the second is what lets a weekly reminder survive a reboot.
    -->
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE"
        tools:node="remove" />

    <application
        android:name=".SweepApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:requestLegacyExternalStorage="true"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="33"
        android:supportsRtl="true"
        android:theme="@style/Theme.Sweep">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Sweep">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Lets the user look at a file before deleting it. Sweep grants a read-only URI for one
          file at a time to whichever app the user picks to view it; it exports nothing itself.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
